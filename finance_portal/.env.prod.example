# =====================================================================
# CANLI ORTAM DEGISKENLERI — ornek dosya
# =====================================================================
# Sunucuda:
#     cp .env.prod.example .env.prod
#     nano .env.prod                  # asagida doldurulmasi istenen alanlari tamamla
#     chmod 600 .env.prod
#
# Calistirma:
#     docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# .env.prod ASLA commit'lenmez (.gitignore'da). Bu ornek dosyada gercek bir sir
# bulunmamalidir.
# =====================================================================

# --- Alan adlari ---------------------------------------------------
# Ucu de bu sunucunun IP'sine A kaydiyla bakmali (Cloudflare'de proxy KAPALI/gri bulut).
APP_DOMAIN=finance.turkbey.dev
AUTH_DOMAIN=auth.turkbey.dev
ROOT_DOMAIN=turkbey.dev

# Let's Encrypt bildirimleri (sertifika yenilenemezse buraya yazar).
ACME_EMAIL=DEGISTIR@ornek.com

# --- Veritabani ----------------------------------------------------
# Keycloak da ayni veritabani sunucusunu kullanir.
DB_NAME=finance_db
DB_USERNAME=finance_user
# Parola uret: openssl rand -hex 24
DB_PASSWORD=DEGISTIR_guclu_bir_parola

# --- Keycloak ------------------------------------------------------
# Yorumlari DEGERIN YANINA yazma; satir sonu yorumlarinin temizlenecegine guvenme.
# Yonetici adi olarak "admin" birakma. Parola uret: openssl rand -hex 24
KEYCLOAK_ADMIN=DEGISTIR_yonetici_adi
KEYCLOAK_ADMIN_PASSWORD=DEGISTIR_guclu_parola
KEYCLOAK_REALM=finance-realm
KEYCLOAK_CLIENT_ID=finance-client

# --- Dis servis anahtarlari ----------------------------------------
# Hepsi istege bagli. Bos birakilirsa ilgili ozellik sessizce devre disi kalir;
# uygulama baslamaya devam eder.
#   EVDS    : TCMB veri servisi (faiz/enflasyon)   https://evds2.tcmb.gov.tr
#   FRED    : ABD makro serileri                   https://fred.stlouisfed.org/docs/api/api_key.html
#   FINNHUB : yedek piyasa verisi                  https://finnhub.io
#   FMP     : sirket temel verileri                https://financialmodelingprep.com
#   GEMINI  : sohbet asistani (birincil)           https://aistudio.google.com/apikey
#   GROQ    : sohbet asistani (yedek)              https://console.groq.com/keys
EVDS_API_KEY=
FRED_API_KEY=
FINNHUB_API_KEY=
FMP_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# --- E-posta (fiyat alarmi bildirimleri) ---------------------------
# false birakilirsa alarmlar kaydedilir ve tetiklenir, sadece posta gonderilmez.
# Gmail kullanacaksan normal hesap parolasi DEGIL, uygulama sifresi gerekir.
APP_MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
