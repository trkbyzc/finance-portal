# =====================================================================
# Caddy — TLS sonlandirma ve yonlendirme (docker-compose.prod.yml)
# =====================================================================
# Caddy, Let's Encrypt sertifikalarini kendisi alir ve yeniler; certbot/cron yok.
# Calismasi icin 80 ve 443 portlarinin disaridan erisilebilir olmasi ve alan
# adlarinin bu sunucuya cozumlenmesi yeterli.
#
# ONEMLI — Cloudflare proxy'si (turuncu bulut) KAPALI olmali. Acikken HTTP-01
# dogrulamasi Cloudflare'de sonlanir, Caddy'ye ulasmaz ve sertifika alinamaz.
#
# .dev uzantisi HSTS preload listesinde: tarayicilar bu alan adlarina duz HTTP
# ile hic gitmez. Yani TLS calismak ZORUNDA, "sonra hallederiz" secenegi yok.
#
# Degiskenler compose'dan environment olarak gelir (APP_DOMAIN, AUTH_DOMAIN,
# ROOT_DOMAIN, ACME_EMAIL).
# =====================================================================
{
	# Sertifika son kullanma / sorun bildirimleri bu adrese gider.
	email {$ACME_EMAIL}
}

# --- Uygulama: React SPA + /api proxy'si (ikisini de nginx sunar) ---
{$APP_DOMAIN} {
	encode zstd gzip

	# nginx.conf hem statik dosyalari sunar hem /api/ -> app-backend:8081 proxy'ler,
	# bu yuzden Caddy tek bir hedefe yonlendirir.
	reverse_proxy app-frontend:80

	# --- Guvenlik basliklari ---
	# NOT: Onceki yorumda "Caddy zaten HSTS ekler" yaziyordu, bu YANLIS.
	# Caddy HSTS eklemez; olculdu, baslik yoktu. auth.turkbey.dev'de gorulen
	# strict-transport-security Keycloak'in kendi ekledigi basliktir.
	header {
		# Tarayici MIME turunu tahmin etmeye calismasin.
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin

		# HTTPS zorunlulugunu tarayiciya bir yil hatirlat. .dev uzantisi zaten
		# HSTS preload listesinde, ama alt alan adlari icin bu satir gerekli.
		# "preload" anahtari BILEREK yok: preload listesine girmek geri alinmasi
		# aylar suren bir taahhut, buradaki kazanci ise .dev sayesinde sifir.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"

		# Tiklama hirsizligi (clickjacking): sayfa hicbir iframe icine alinamaz.
		# X-Frame-Options eski tarayicilar, frame-ancestors ise yenileri icin.
		X-Frame-Options DENY

		# Kullanilmayan tarayici yetenekleri kapatilir. Bir XSS gerceklesse bile
		# kamera/mikrofon/konum istenemez.
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"

		# Acilan pencerelerle bu sayfa arasindaki baglantiyi kes (tabnabbing).
		Cross-Origin-Opener-Policy same-origin

		# --- Icerik Guvenlik Politikasi (ZORLAYICI) ---
		# Once rapor modunda yayinlandi, tarayici konsolundan dogrulandi (2026-09-10):
		# script/style/font/connect/frame yonergelerinin HICBIRI ihlal edilmedi.
		# Ozellikle paketteki `Function("return this")` (globalThis polyfill'i)
		# TETIKLENMIYOR — || zinciri ona ulasmadan kisa devre yapiyor. Bu yuzden
		# 'unsafe-eval'e gerek kalmadi, script-src en sikisi ('self') olarak kaldi.
		#
		# img-src NEDEN `https:` (her HTTPS kaynagi)?
		# Haberler RSS'ten geliyor ve kucuk resimler kaynagin kendi sunucusunda barinir:
		# aa.com.tr, tmgrup.com.tr, coin-turk.com, uzmancoin.com... Bu liste akis
		# degistikce degisir; sabit bir izin listesi bugun degilse gelecek hafta
		# haberleri kirar. Gorselleri backend uzerinden proxy'lemek de dogru degil,
		# o zaman telifli gorseli BIZ sunmus oluruz — canli demoda kacindigimiz sey.
		# Gorsel kod calistirmaz; script-src 'self' yerinde durdugu surece bedeli dusuk.
		#
		# object-src 'none': jsPDF disa aktarimi doc.save() ile (blob indirme) yapiliyor.
		# Kutuphanenin cdnjs'ten pdfobject.min.js ceken yolu HIC cagrilmiyor, olu kod.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://auth.turkbey.dev; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' https://auth.turkbey.dev; frame-ancestors 'none'"

		# Sunucu imzasini gizle.
		-Server
	}

	log {
		output stdout
		format console
	}
}

# --- Keycloak: ayri alan adi ---
# Uygulamayla ayni alan adi altinda bir yol (/auth) yerine ayri host tercih edildi:
# Keycloak'i alt yolda calistirmak KC_HTTP_RELATIVE_PATH + cerez kapsami ayarlari
# gerektirir ve realm'daki mevcut redirect URI'lari bozar.
#
# Caddy X-Forwarded-Proto/Host/For basliklarini otomatik ekler; Keycloak tarafinda
# karsiligi KC_PROXY_HEADERS=xforwarded (compose'da ayarli). Bu ikisi eslesmezse
# Keycloak kendini http:// zanneder ve giris sonrasi yanlis adrese yonlendirir.
{$AUTH_DOMAIN} {
	reverse_proxy keycloak:8080

	log {
		output stdout
		format console
	}
}

# --- Kok alan adi -> uygulamaya kalici yonlendirme ---
# A kaydi bu sunucuyu gosterdigi icin burasi bos birakilirsa ziyaretci TLS
# hatasi gorur. Kisisel alan adinda kotu bir ilk izlenim olurdu.
{$ROOT_DOMAIN} {
	redir https://{$APP_DOMAIN}{uri} permanent
}
